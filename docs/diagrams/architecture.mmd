%%build: {"fontSize": 12}
%%{init: {"flowchart": {"nodeSpacing": 12, "rankSpacing": 16}}}%%
flowchart TB
  subgraph host[DSH host]
    direction LR
    ui[Web UI / TUI] --> agent[Agent session] --> model[Model route]
  end

  subgraph bundle[Plugin bundle - every preset]
    direction LR
    b1[Notebook and results]
    b2[Documents and figures]
    b3[Data and templates]
    b4[Remote compute]
    b5[Settings]
  end

  subgraph preset[Academic Harness preset]
    direction LR
    p1[Search and evidence]
    p2[Writing and citation]
    p3[Reviews and tournaments]
    p4[Skills and subagents]
    p5[Specialist workflows]
  end

  providers[External providers]
  state[Local state]

  host ==> bundle
  host ==> preset
  bundle ==> state
  preset ==> providers
  preset ==> state

  classDef host fill:#eef2ff,stroke:#6366f1,color:#312e81
  classDef bundle fill:#f8fafc,stroke:#64748b,color:#0f172a
  classDef preset fill:#ecfdf5,stroke:#10b981,color:#064e3b
  classDef state fill:#fff7ed,stroke:#f97316,color:#7c2d12
  classDef external fill:#fdf2f8,stroke:#db2777,color:#831843
  class ui,agent,model host
  class b1,b2,b3,b4,b5 bundle
  class p1,p2,p3,p4,p5 preset
  class state state
  class providers external
