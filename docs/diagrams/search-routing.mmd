flowchart TD
  question[Research question] --> known{Known paper?}
  known -->|yes - DOI, PMID, or arXiv ID| resolve[paper_resolve]
  resolve --> integrity[integrity_check]
  known -->|no| need{Literature or web?}

  need -->|literature| router[literature_search router]
  router --> openalex[OpenAlex]
  router --> s2[Semantic Scholar]
  router --> pubmed[PubMed / Europe PMC]
  router --> arxiv[arXiv]
  router --> crossref[Crossref]
  router --> biorxiv[bioRxiv / medRxiv]
  router --> inspire[INSPIRE-HEP]
  router --> ads[NASA ADS<br/>only with token]
  router --> scopus[Scopus<br/>explicit + key]
  router --> wos[Web of Science<br/>explicit + key]

  need -->|source-specific action| domain[domain_search]
  domain -.-> biorxiv
  domain -.-> inspire
  domain -.-> ads
  domain -.-> scopus
  domain -.-> wos

  need -->|peer-reviewed filters| consensus[Consensus]
  need -->|web or current facts| parallel[parallel_search]
  parallel --> web[Brave · Tavily · Exa<br/>Perplexity · Jina]
  need -->|broad web reading| fetch[Parallel Extract<br/>Firecrawl · Jina Reader]

  openalex --> next[Full-text pipeline<br/>see Papers and evidence]
  s2 --> next
  pubmed --> next
  arxiv --> next
  crossref --> next
  biorxiv --> next
  inspire --> next
  ads --> next
  scopus --> next
  wos --> next
  consensus --> next
  web --> next
  fetch --> next
  integrity --> next

  classDef entry fill:#ecfdf5,stroke:#059669,color:#064e3b
  classDef decision fill:#eef2ff,stroke:#6366f1,color:#312e81
  classDef source fill:#f8fafc,stroke:#94a3b8,color:#0f172a
  classDef next fill:#fff7ed,stroke:#f97316,color:#7c2d12
  class question entry
  class known,need decision
  class resolve,integrity,router,domain,openalex,s2,pubmed,arxiv,crossref,biorxiv,inspire,ads,scopus,wos,consensus,parallel,web,fetch source
  class next next
