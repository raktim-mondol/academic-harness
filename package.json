{
  "name": "dsh-researchcraft",
  "version": "0.14.0",
  "description": "ResearchCraft as a DeepSeek Harness profile: DSH web UI and agent, scientific skills, lab notebook, specialist subagents.",
  "icon": "assets/icon.svg",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./mcp-connectors": "./mcp-connectors.js",
    "./zvec-grep": "./zvec-grep.js",
    "./zvec-index": "./zvec-index.js",
    "./consensus-search": "./consensus-search.js",
    "./parallel-search": "./parallel-search.js",
    "./paper-download": "./paper-download.js",
    "./paper-mcp": "./paper-mcp.js",
    "./papermemory": "./papermemory.js",
    "./academic-harness": "./academic-harness.js",
    "./academic-harness-hooks": "./academic-harness-hooks.js",
    "./subagent-models": "./subagent-models.js",
    "./prompt-section": "./prompt-section.js",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/icon.svg",
    "locale",
    "index.js",
    "notebook.js",
    "notebook-export.js",
    "notebook-zip.js",
    "scientific-result.js",
    "image-generate.js",
    "image-gen-client.js",
    "image-gen-config.js",
    "sci-inspect.js",
    "latex-compile.js",
    "pdf-to-markdown.js",
    "modal-run.js",
    "modal-instances.js",
    "runpod-run.js",
    "runpod-client.js",
    "runpod-instances.js",
    "workflows.js",
    "workflows.json",
    "credential-env.js",
    "settings-keys.js",
    "mcp-connectors.js",
    "zvec-grep.js",
    "zvec-grep-cli.js",
    "zvec-index-engine.js",
    "zvec-index.js",
    "consensus-search.js",
    "parallel-search.js",
    "paper-download.js",
    "paper-mcp.js",
    "papermemory.js",
    "papermemory-cli.js",
    "academic-harness.js",
    "academic-harness-cli.js",
    "academic-harness-hooks.js",
    "subagent-models.js",
    "prompt-section.js",
    "prompt.js",
    "seed.js",
    "cordis.patch.yml",
    "presets",
    "skills",
    "python-helpers",
    "vendor",
    "lib",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raktim-mondol/dsh-researchcraft.git"
  },
  "homepage": "https://github.com/raktim-mondol/dsh-researchcraft#readme",
  "bugs": {
    "url": "https://github.com/raktim-mondol/dsh-researchcraft/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node build-client.mjs",
    "build:patch": "node scripts/build-cordis-patch.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@firecrawl/pdf-inspector": "^1.17.0",
    "adm-zip": "^0.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-system-prompt": "*",
    "modal": "^0.8.2"
  },
  "peerDependenciesMeta": {
    "modal": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "researchcraft"
  ]
}
