      "cues": ["abstract", "structured summary", "trial registration", "conclusions"],
      "source_url": "https://www.consort-statement.org/checklists/view/32-consort-2010"
    },
    {
      "id": "2a",
      "section": "Introduction",
      "short_prompt": "The introduction states the scientific background and rationale.",
      "cues": ["background", "rationale", "evidence", "prior stud"],
